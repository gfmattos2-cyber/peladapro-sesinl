{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "peladapro/cards-manifest.schema.json",
  "title": "PlayerCardManifest",
  "type": "object",
  "required": ["schemaVersion", "releaseVersion", "releaseStatus", "players"],
  "properties": {
    "schemaVersion": { "type": "string" },
    "assetVersion": { "type": "string" },
    "releaseVersion": { "type": "string" },
    "releaseStatus": { "type": "string", "enum": ["release-candidate", "stable"] },
    "generatedAt": { "type": "string" },
    "templateVersion": { "type": "string" },
    "ratingContractVersion": { "type": "string" },
    "players": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["playerId", "displayName", "nameReviewStatus", "isGoalkeeper", "card", "ratingSlot"],
        "properties": {
          "playerId": { "type": "string", "pattern": "^[a-z0-9-]+$" },
          "displayName": { "type": "string" },
          "aliases": { "type": "array", "items": { "type": "string" } },
          "nameReviewStatus": { "type": "string", "enum": ["confirmed", "pending"] },
          "sourceFile": { "type": "string" },
          "countryCode": { "type": "string" },
          "isGoalkeeper": { "type": "boolean" },
          "positionGroup": { "type": "string" },
          "assetStatus": { "type": "string" },
          "card": {
            "type": "object",
            "required": ["png", "webp", "thumbnail", "width", "height", "hasAlpha", "sha256Png", "sha256Webp"],
            "properties": {
              "png": { "type": "string", "pattern": "^/player-cards/" },
              "webp": { "type": "string", "pattern": "^/player-cards/" },
              "thumbnail": { "type": "string", "pattern": "^/player-cards/" },
              "width": { "type": "integer", "minimum": 1 },
              "height": { "type": "integer", "minimum": 1 },
              "aspectRatio": { "type": "number" },
              "hasAlpha": { "type": "boolean" },
              "sha256Png": { "type": "string", "minLength": 64, "maxLength": 64 },
              "sha256Webp": { "type": "string", "minLength": 64, "maxLength": 64 },
              "sizeBytesPng": { "type": "integer" },
              "sizeBytesWebp": { "type": "integer" }
            }
          },
          "ratingSlot": {
            "type": "object",
            "required": ["xPercent", "yPercent", "widthPercent", "heightPercent", "textAlign"],
            "properties": {
              "xPercent": { "type": "number", "minimum": 0, "maximum": 1 },
              "yPercent": { "type": "number", "minimum": 0, "maximum": 1 },
              "widthPercent": { "type": "number", "minimum": 0, "maximum": 1 },
              "heightPercent": { "type": "number", "minimum": 0, "maximum": 1 },
              "textAlign": { "type": "string" },
              "fontSizePercent": { "type": "number" },
              "displayMode": { "type": "string" },
              "sourceScaleMin": { "type": "number" },
              "sourceScaleMax": { "type": "number" },
              "decimalPlaces": { "type": "integer" },
              "locale": { "type": "string" }
            }
          },
          "warnings": { "type": "array", "items": { "type": "string" } }
        }
      }
    }
  }
}
